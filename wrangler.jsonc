{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratarui",
  "main": "worker.js",
  "compatibility_date": "2026-02-01",
  "keep_vars": true,
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}