{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratarui",
  "main": "worker.js",
  "compatibility_date": "2026-02-01",
  "keep_vars": true,
  "vars": {
    "TELEGRAM_CHAT_ID": "-1004414245980"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}